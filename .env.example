DATABASE_URL=postgres://user:password@localhost:5432/waslni
JWT_SECRET=غيّر-دا-لنص-عشوائي-طويل
PORT=3000
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}   # اختياري: لتفعيل الإشعارات (JSON في سطر واحد)
ENC_KEY=مفتاح-تشفير-عشوائي-طويل-ومختلف-عن-JWT_SECRET   # لتشفير الرقم القومي. لا تغيّره بعد الإطلاق
ADMIN_CODE=كود-سري-للتسجيل-كإدارة   # من يعرفه يقدر يسجّل حساب إدارة من التطبيق. اجعله طويل وغير تخميني
SMS_PROVIDER=twilio   # مزوّد الرسائل (OTP). بدونه لا يمكن إنشاء حسابات جديدة
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_FROM=+1XXXXXXXXXX   # رقم مرسل، أو استخدم TWILIO_MESSAGING_SERVICE_SID بدلًا منه
#OTP_SECRET=   # اختياري: مفتاح بصمة الأكواد (الافتراضي ENC_KEY)
